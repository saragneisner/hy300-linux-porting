#!/usr/bin/env bash
# Task Management Tool for HY300 Linux Porting Project - ENHANCED VERSION

set -euo pipefail

# Find project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
TASKS_DIR="$PROJECT_ROOT/tasks"
COMPLETED_DIR="$TASKS_DIR/completed"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat << EOF
Task Management Tool for HY300 Linux Porting Project

Usage: $0 <command> [options]

Commands:
    list                    List all tasks with status
    active                  Show in_progress and pending tasks
    next                    Find next priority task to work on
    create <name>           Create new task file
    start <task_id>         Mark task as in_progress
    complete <task_id>      Mark task as completed (moves to completed/, updates README)
    block <task_id> <reason> Mark task as blocked with reason
    status <task_id>        Show task status and details
    find-inprogress        Find any in_progress tasks
    validate               Validate all task files
    import-phase <phase>    Auto-import all tasks from phase README

Examples:
    $0 list
    $0 next
    $0 start 002
    $0 complete 001
    $0 import-phase phase1-hardware-baseline

EOF
}

# Import tasks from phase README
import_phase_tasks() {
    local phase_input="$1"
    local phase_dir=""
    
    # Try exact match first
    if [[ -d "$PROJECT_ROOT/phases/$phase_input" && -f "$PROJECT_ROOT/phases/$phase_input/README.md" ]]; then
        phase_dir="$PROJECT_ROOT/phases/$phase_input"
    else
        # Try with wildcard match
        for dir in "$PROJECT_ROOT/phases/${phase_input}"*; do
            if [[ -d "$dir" && -f "$dir/README.md" ]]; then
                phase_dir="$dir"
                break
            fi
        done
    fi
    
    if [[ ! -f "$phase_dir/README.md" ]]; then
        echo -e "${RED}❌ README not found for: $phase_input${NC}"
        return 1
    fi
    
    echo -e "${BLUE}Importing tasks from: $phase_dir/README.md${NC}"
    echo
    
    mkdir -p "$TASKS_DIR"
    local imported=0
    local temp_tasks=$(mktemp)
    
    # Extract all task lines
    grep "^### Task [0-9]" "$phase_dir/README.md" > "$temp_tasks" || true
    
    # Process each task
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        # Extract task number
        local task_num=$(echo "$line" | sed -E 's/^### Task ([0-9]+).*/\1/')
        # Extract task title  
        local task_title=$(echo "$line" | sed -E 's/^### Task [0-9]+:[[:space:]]*(.*)$/\1/')
        
        # Check if already exists
        local exists=0
        for f in "$TASKS_DIR"/*"$task_num"-*.md "$COMPLETED_DIR"/*"$task_num"-*.md; do
            [[ -f "$f" ]] && exists=1 && break
        done
        
        if [[ $exists -eq 1 ]]; then
            echo -e "${YELLOW}⏭️  Task $task_num already exists${NC}"
            continue
        fi
        
        # Create clean title for filename
        local clean_title=$(printf "%s" "$task_title" | sed -E 's/[^a-zA-Z0-9]/-/g' | sed -E 's/-+/-/g' | sed 's/-$//')
        local filename=$(printf "%03d" "$task_num")-$clean_title.md
        local filepath="$TASKS_DIR/$filename"
        
        # Create task file
        cat > "$filepath" << 'TASKEOF'
# Task NNN: TTT

**Status:** pending
**Priority:** medium
**Phase:** PHPH
**Created:** CCCC

## Imported from phase README

This task was auto-imported from the Phase README.

## Next Steps

- [ ] Review task in phase README  
- [ ] Update this file with implementation details
- [ ] Mark as in_progress when starting

## Notes

Auto-generated from phase README.
TASKEOF
        
        # Update placeholders
        sed -i "s/^# Task NNN:/# Task $task_num:/" "$filepath"
        sed -i "s/ TTT:/ $task_title:/" "$filepath"
        sed -i "s/PHPH/$(basename "$phase_dir")/" "$filepath"
        sed -i "s/CCCC/$(date +%Y-%m-%d)/" "$filepath"
        
        echo -e "${GREEN}✅ Task $task_num: $task_title${NC}"
        ((imported++))
        
    done < "$temp_tasks"
    
    rm -f "$temp_tasks"
    
    echo
    echo -e "${GREEN}✅ Imported $imported task(s)${NC}"
}

# Update phase README when task is completed
update_phase_readme() {
    local task_id="$1"
    local task_file="$2"
    
    # Extract phase from task file
    local phase=$(grep "^**Phase:" "$task_file" | head -1 | sed 's/.*Phase:[[:space:]]*\(.*\)$/\1/')
    
    if [[ -z "$phase" ]]; then
        return 0  # Not part of a structured phase
    fi
    
    # Find phase README
    local phase_readme=""
    if [[ -f "$PROJECT_ROOT/phases/$phase/README.md" ]]; then
        phase_readme="$PROJECT_ROOT/phases/$phase/README.md"
    else
        for dir in "$PROJECT_ROOT/phases/${phase}"*; do
            if [[ -f "$dir/README.md" ]]; then
                phase_readme="$dir/README.md"
                break
            fi
        done
    fi
    
    if [[ ! -f "$phase_readme" ]]; then
        return 0
    fi
    
    # Update README: Mark task status as completed
    local task_pattern="### Task $(printf '%03d' "$task_id"):"
    
    # Create temp file with updates
    local temp_file=$(mktemp)
    local in_task=false
    
    while IFS= read -r line; do
        if [[ "$line" =~ ^###\ Task\ [0-9]+ ]]; then
            in_task=false
            if [[ "$line" == *"$task_pattern"* ]]; then
                in_task=true
            fi
        fi
        
        if $in_task && [[ "$line" =~ ^\\*\\*Status:\\*\\* ]]; then
            echo "**Status:** completed ✅" >> "$temp_file"
        else
            echo "$line" >> "$temp_file"
        fi
    done < "$phase_readme"
    
    # Only replace if changes were made
    if grep -q "completed ✅" "$temp_file"; then
        mv "$temp_file" "$phase_readme"
        echo -e "${GREEN}📝 Updated phase README${NC}"
    else
        rm "$temp_file"
    fi
}

# Update task status
update_status() {
    local task_id="$1"
    local new_status="$2"
    local reason="${3:-}"
    
    # Find task file
    local task_file=""
    for file in "$TASKS_DIR"/*"$task_id"*.md "$COMPLETED_DIR"/*"$task_id"*.md; do
        if [[ -f "$file" ]]; then
            task_file="$file"
            break
        fi
    done
    
    if [[ ! -f "$task_file" ]]; then
        echo "Task not found: $task_id" >&2
        return 1
    fi
    
    # Update status in file
    sed -i "s/\*\*Status:\*\*.*/\*\*Status:\*\* $new_status/" "$task_file"
    
    if [[ -n "$reason" ]]; then
        echo "" >> "$task_file"
        echo "**Blocked:** $reason" >> "$task_file"
    fi
    
    echo -e "${GREEN}✅ Task $task_id status: $new_status${NC}"
    
    # Move file if needed
    if [[ "$new_status" == "completed" ]]; then
        mkdir -p "$COMPLETED_DIR"
        mv "$task_file" "$COMPLETED_DIR/"
        echo -e "${GREEN}📁 Moved to completed${NC}"
        
        # Update phase README
        update_phase_readme "$task_id" "$COMPLETED_DIR/$(basename "$task_file")"
    elif [[ "$new_status" == "in_progress" ]]; then
        mkdir -p "$TASKS_DIR/in-progress"
        if [[ "$task_file" != *"/in-progress/"* ]]; then
            mv "$task_file" "$TASKS_DIR/in-progress/"
            echo -e "${GREEN}📁 Moved to in-progress${NC}"
        fi
    fi
}

# List tasks
list_tasks() {
    echo -e "${BLUE}HY300 Tasks${NC}"
    echo "==========="
    echo
    
    if [[ -d "$TASKS_DIR" ]]; then
        for file in "$TASKS_DIR"/*/*.md "$TASKS_DIR"/*.md; do
            [[ -f "$file" ]] || continue
            local status=$(grep "^**Status:" "$file" 2>/dev/null | sed 's/.*Status:[[:space:]]*\(.*\)$/\1/' | head -1)
            echo "🔄 $(basename "$file" .md) [$status]"
        done
    fi
    
    echo
    echo -e "${GREEN}Completed:${NC}"
    if [[ -d "$COMPLETED_DIR" ]]; then
        for file in "$COMPLETED_DIR"/*.md; do
            [[ -f "$file" ]] || continue
            echo "✅ $(basename "$file" .md)"
        done
    fi
}

# Main command handler
case "${1:-}" in
    import-phase)
        if [[ -z "${2:-}" ]]; then
            echo "Error: Phase name required"
            usage
            exit 1
        fi
        import_phase_tasks "$2"
        ;;
    complete)
        if [[ -z "${2:-}" ]]; then
            echo "Error: Task ID required"
            usage
            exit 1
        fi
        update_status "$2" "completed"
        ;;
    start)
        if [[ -z "${2:-}" ]]; then
            echo "Error: Task ID required"
            usage
            exit 1
        fi
        update_status "$2" "in_progress"
        ;;
    list)
        list_tasks
        ;;
    *)
        usage
        exit 0
        ;;
esac
