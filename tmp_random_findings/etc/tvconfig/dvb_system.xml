-->
<AllData BigEnd="1" BuildName="1" Comment="">
	<Tuner>
		<EXTERNAL_DemodType Val="402" />
		<!-- 0 means TSStream, 9 means DRX_SX6, 402 mean external demod_atbm783x -->
