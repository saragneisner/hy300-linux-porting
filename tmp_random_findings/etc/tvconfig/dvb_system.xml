		<BUILDIN_CIPath Val="0" />	<!-- 0:CI_ByPass, 1:CI_Out_TS1, 2:CI_Out_TS2 -->
		<BUILDIN_ClockReverse Val="1" />	<!-- 0:falling clock edge trigger, 1:raising clock edge trigger -->

		<DAgc2AmpRef0 Val="0x0440"/> <!-- ATBM253 debug for IF signal value; 0x0440:DTMB\ISDB\ATSC\DVBT; 0x0480:DVBC; 0x04E0: ATV -->
