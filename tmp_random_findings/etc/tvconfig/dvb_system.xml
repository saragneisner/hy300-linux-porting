		<EXTERNAL_RFI2cAddr RFI2CCnt="1" Val1="0xC0"/> <!-- ATBM253&SI2151 is 0xC0, R842 is 0xF6 -->
		<EXTERNAL_SerialTS Val="0" />		<!-- 0 means Parallel, 1 means Serial -->
		<EXTERNAL_TSOutput Val="3" />	<!-- 0:Serial_TS, 1: Serial_Demod , 2: Serial_TS1,  3: Parallel_Demod , 4:Parallel_TS1, 5:Parallel_TS2  -->
		<EXTERNAL_CIPath Val="0" />	<!-- 0:CI_ByPass, 1:CI_Out_TS1, 2:CI_Out_TS2 -->
		<EXTERNAL_ClockReverse Val="1" />	<!-- 0:falling clock edge trigger, 1:raising clock edge trigger -->

		<BUILDIN_DemodType Val="9" />
		<!-- 0 means TSStream, 9 means DRX_SX6 -->
		<BUILDIN_RFType RFTypeCnt="3" Val1="34" Val2="35" Val3="36" />
		<!-- 0 means NULL, 34 means ATBM253, 35 means SI2151(0xC0), 36 means R842(0xF6) -->
		<BUILDIN_RFI2cAddr RFI2CCnt="3" Val1="0xC0" Val2="0xC0" Val3="0xF6"/> <!-- ATBM253&SI2151 is 0xC0, R842 is 0xF6 -->
