	dcxo24M_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "dcxo24M";
		phandle = <0x14>;
	};

	interrupt-controller@3020000 {
		compatible = "arm,cortex-a15-gic\0arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0x3021000 0x00 0x1000 0x00 0x3022000 0x00 0x2000 0x00 0x3024000 0x00 0x2000 0x00 0x3026000 0x00 0x2000>;
		interrupts = <0x01 0x09 0xf04>;
		interrupt-parent = <0x08>;
		phandle = <0x08>;
	};

	interrupt-controller@0 {
		compatible = "allwinner,sunxi-wakeupgen";
		interrupt-controller;
		#interrupt-cells = <0x03>;
		interrupt-parent = <0x08>;
		phandle = <0x01>;
	};

	timer_arch {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04 0x01 0x0b 0xf04 0x01 0x0a 0xf04>;
		clock-frequency = <0x16e3600>;
		interrupt-parent = <0x08>;
		arm,no-tick-in-suspend;
	};

	iommu@2010000 {
		compatible = "allwinner,sunxi-iommu";
		reg = <0x00 0x2010000 0x00 0x1000>;
		interrupts = <0x00 0x47 0x04>;
		interrupt-names = "iommu-irq";
		clocks = <0x02 0x30>;
		clock-names = "iommu";
		#iommu-cells = <0x02>;
		phandle = <0x11>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0xac 0x04 0x00 0xad 0x04 0x00 0xae 0x04 0x00 0xaf 0x04>;
		interrupt-affinity = <0x09 0x0a 0x0b 0x0c>;
	};

	power-management@ff000000 {
		compatible = "allwinner,tv303-pmu\0syscon\0simple-mfd";
		reg = <0x00 0x7001000 0x00 0x400>;
		phandle = <0x65>;

		power-controller {
			compatible = "allwinner,tv303-power-controller";
			clocks = <0x0d 0x0f>;
			clock-names = "ppu";
			resets = <0x0d 0x06>;
			reset-names = "ppu_rst";
			#power-domain-cells = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x12>;

			pd_gpu@0 {
				reg = <0x00>;
			};

			pd_tvfe@1 {
				reg = <0x01>;
			};

			pd_tvcap@2 {
				reg = <0x02>;
			};

			pd_ve@3 {
				reg = <0x03>;
			};

			pd_av1@4 {
				reg = <0x04>;
			};
		};
