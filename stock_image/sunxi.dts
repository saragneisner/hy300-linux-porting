	thermal-zones {

		cpu_thermal_zone {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x0e 0x01>;
			sustainable-power = <0x228>;

			trips {
				phandle = <0x66>;

				trip-point@0 {
					temperature = <0x13880>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x67>;
				};

				trip-point@1 {
					temperature = <0x19a28>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x0f>;
				};

				cpu_crit@0 {
					temperature = <0x1c138>;
					type = "critical";
					hysteresis = <0x00>;
					phandle = <0x68>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0f>;
					cooling-device = <0x09 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};

				map1 {
					trip = <0x0f>;
					cooling-device = <0x10 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		gpu_thermal_zone {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x0e 0x00>;
			sustainable-power = <0x228>;
		};
	};

