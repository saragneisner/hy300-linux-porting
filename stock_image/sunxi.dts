/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "sun50iw12";
	compatible = "allwinner,tv303\0arm,sun50iw12p1";

	aliases {
		mmc0 = "/soc@2900000/sdmmc@4020000";
		mmc2 = "/soc@2900000/sdmmc@4022000";
		spi0 = "/soc@2900000/spi@4025000";
		spi1 = "/soc@2900000/spi@4026000";
		twi0 = "/soc@2900000/twi@2502000";
		twi1 = "/soc@2900000/twi@2502400";
		twi2 = "/soc@2900000/twi@2502800";
		twi3 = "/soc@2900000/twi@2502C00";
		twi4 = "/soc@2900000/r_twi@7081400";
		twi5 = "/soc@2900000/r_twi@7081800";
		nand0 = "/soc@2900000/nand0@04011000";
		global-timer0 = "/soc@2900000/timer@3060000";
		ir0 = "/soc@2900000/s_cir@7040000";
		ac200 = "/soc@2900000/ac200@0";
		pwm = "/soc@2900000/pwm@2000c00";
		pwm0 = "/soc@2900000/pwm0@2000c10";
		pwm1 = "/soc@2900000/pwm1@2000c11";
		pwm2 = "/soc@2900000/pwm2@2000c12";
		pwm3 = "/soc@2900000/pwm3@2000c13";
		pwm4 = "/soc@2900000/pwm4@2000c14";
		pwm5 = "/soc@2900000/pwm5@2000c15";
		pwm6 = "/soc@2900000/pwm6@2000c16";
		pwm7 = "/soc@2900000/pwm7@2000c17";
		s_pwm = "/soc@2900000/s_pwm@7020c00";
		s_pwm0 = "/soc@2900000/s_pwm0@7020c10";
		s_pwm1 = "/soc@2900000/s_pwm1@7020c11";
		s_pwm2 = "/soc@2900000/s_pwm2@7004012";
		ve0 = "/soc@2900000/ve@1c0e000";
		ve1 = "/soc@2900000/ve1@1c0e000";
		serial0 = "/soc@2900000/uart@2500000";
		serial1 = "/soc@2900000/uart@2500400";
		arisc_config = "/arisc_config";
		standby_param = "/standby_param";
		cir_param = "/cir_param";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		bl31 {
			reg = <0x00 0x48000000 0x00 0x180000>;
		};

		optee {
			reg = <0x00 0x48600000 0x00 0x100000>;
		};

		mipsloader {
			reg = <0x00 0x4b100000 0x00 0x2841000>;
			phandle = <0x5d>;
		};

		decd {
			reg = <0x00 0x4d941000 0x00 0x20000>;
			phandle = <0x5c>;
		};

		cpu_comm {
			reg = <0x00 0x4e300000 0x00 0x500000>;
			phandle = <0x62>;
		};

		framebuf {
			reg = <0x00 0x4bf41000 0x00 0x1a00000>;
			phandle = <0x63>;
		};
	};

	firmware {

		android {
			compatible = "android,firmware";
			boot_devices = "soc@2900000/4020000.sdmmc,soc@2900000/4022000.sdmmc,soc@2900000";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,vbmeta_system,vbmeta_vendor,boot";
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};

		mips {

			mips_code {
				file_name = "display.bin";
				cert_name = "display.der";
				load_addr = <0x4b100000>;
			};

			mips_database {
				file_name = "database.TSE";
				cert_name = "database.der";
				load_addr = <0x4ba00000>;
			};

			mips_project_table {
				file_name = "projecttable.TSE";
				cert_name = "projecttable.der";
			};

			mips_db_project {
				file_name = "ProjectID_";
			};

			mips_xml {
				file_name = "mips.xml";
				load_addr = <0x4f308000>;
			};

			mips_memory {
				mips_only_size = <0x3200000>;
				shm_size = <0x1018000>;
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			clocks = <0x02 0x13>;
			dynamic-power-coefficient = <0xf6>;
			cpu-idle-states = <0x03 0x04>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x06>;
			phandle = <0x09>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			clocks = <0x02 0x13>;
			dynamic-power-coefficient = <0xf6>;
			cpu-idle-states = <0x03 0x04>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			clocks = <0x02 0x13>;
			dynamic-power-coefficient = <0xf6>;
			cpu-idle-states = <0x03 0x04>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			clocks = <0x02 0x13>;
			dynamic-power-coefficient = <0xf6>;
			cpu-idle-states = <0x03 0x04>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x2e>;
				exit-latency-us = <0x3b>;
				min-residency-us = <0xdf2>;
				local-timer-stop;
				phandle = <0x03>;
			};

			cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <0x2f>;
				exit-latency-us = <0x4a>;
				min-residency-us = <0x1388>;
				local-timer-stop;
				phandle = <0x04>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	dump-reg@100000 {
		compatible = "allwinner,sunxi-dump-reg";
		reg = <0x00 0x100000 0x00 0x04>;
		phandle = <0x64>;
	};

	cpu-opp-table {
		compatible = "allwinner,sun50i-operating-points";
		nvmem-cells = <0x07>;
		nvmem-cell-names = "speed";
		opp-shared;
		phandle = <0x05>;

		opp@672000000 {
			opp-hz = <0x00 0x280de800>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt = <0xdbba0>;
			opp-microvolt-0x00010042 = <0xdbba0>;
			opp-microvolt-0x00020042 = <0xdbba0>;
			opp-microvolt-0x00040042 = <0xdbba0>;
			opp-microvolt-0x00090042 = <0xdbba0>;
			opp-microvolt-0x000a0042 = <0xdbba0>;
			opp-microvolt-0x000c0042 = <0xdbba0>;
			opp-microvolt-0x00010043 = <0xdbba0>;
			opp-microvolt-0x00020043 = <0xdbba0>;
			opp-microvolt-0x00040043 = <0xdbba0>;
			opp-microvolt-0x00090043 = <0xdbba0>;
			opp-microvolt-0x000a0043 = <0xdbba0>;
			opp-microvolt-0x000c0043 = <0xdbba0>;
			opp-microvolt-0x0002001f = <0xdbba0>;
			opp-microvolt-0x0002002f = <0xdbba0>;
